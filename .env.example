# Copy to .env (used by docker compose and by the gateway). Never commit .env.
JWT_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
ADMIN_EMAILS=you@example.com
# SMTP (empty = confirmation / reset links are printed in the gateway logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PHYTORA <no-reply@phytora.app>"
# Model API: which DVC model folder and which ONNX file to serve
MODEL_DIR=/app/models/legacy
ONNX_VARIANT=
# MOCK=1 serves random results (UI development without model files)
MOCK=0
