PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/phytora
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:3000
MODEL_API_URL=http://127.0.0.1:8000
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
# SMTP for confirmation and reset emails (if empty, the reset link is printed in the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PHYTORA <no-reply@phytora.app>"
# comma-separated emails that become admins automatically
ADMIN_EMAILS=you@example.com
# Set to 1 only if the API runs behind ONE reverse proxy (so rate limiting sees real client IPs)
TRUST_PROXY=
